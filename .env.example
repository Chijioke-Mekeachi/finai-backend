## FinTrack Pro backend environment template
## Copy to backend/.env and fill in values.

# Supabase project config (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Auth verification
#
# If your project still uses HS256 access tokens, set the JWT secret:
# (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#
# If your Supabase access tokens are signed with ES256/RS256 (have `alg`=ES256 and a `kid`),
# the backend will verify them via JWKS. You can optionally override the URL:
# SUPABASE_AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# JWKS fetch timeout (seconds). Defaults to 15.
# SUPABASE_AUTH_JWKS_TIMEOUT_S=15

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Gemini (optional, enables /api/ai/analyze and /api/ai/vision)
GEMINI_API_KEY=your-gemini-api-key
# Default model for /api/ai/* (examples: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash
# API version for Google Generative Language API (try v1beta, and switch to v1 if needed)
GEMINI_API_VERSION=v1beta

# Debug only: include upstream Gemini error messages in /api/ai/* responses
DEBUG_AI_ERRORS=0

# Admin (dev only): required for /admin/* endpoints
ADMIN_API_KEY=change-me-admin

# Paystack (optional, enables Paystack checkout for subscription upgrades)
PAYSTACK_SECRET_KEY=
# Currency for Paystack charges (e.g. NGN or USD). Amounts are in the currency's smallest unit.
PAYSTACK_CURRENCY=USD
# Optional: override plan amounts in smallest currency unit (comma-separated).
# Example (USD): standard=1200,strategic=2500,executive=7500
# Example (NGN): standard=120000,strategic=250000,executive=750000
PAYSTACK_PLAN_AMOUNTS=
